{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["gru1"],
  "buildCommand": "node scripts/build-deployment.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/finnegans-config.js": { "maxDuration": 20 },
    "api/finnegans-token.js": { "maxDuration": 20 },
    "api/finnegans-report.js": { "maxDuration": 60 },
    "api/workspace.js": { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/", "destination": "/cashflow.html" }
  ]
}
